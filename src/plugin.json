{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "OpenRVDAS",
  "id": "oceandatatools-openrvdas-datasource",
  "metrics": true,
  "backend": true,
  "executable": "gpx_openrvdas",
  "info": {
    "description": "Real-time streaming of OpenRVDAS CachedDataServer fields into Grafana",
    "author": {
      "name": "OceanDataTools.org",
      "url": "https://oceandatatools.github.io"
    },
    "keywords": ["datasource", "openrvdas", "streaming", "oceanography", "realtime"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://oceandatatools.github.io"
      },
      {
        "name": "GitHub",
        "url": "https://github.com/OceanDataTools/grafana-openrvdas-datasource"
      },
      {
        "name": "License",
        "url": "https://raw.githubusercontent.com/OceanDataTools/grafana-openrvdas-datasource/refs/heads/main/LICENSE"
      },
      {
        "name": "Sponsorship",
        "url": "https://github.com/sponsors/webbpinner"
      }
    ],
    "screenshots": [
      {
        "name": "Live dashboard streaming from OpenRVDAS",
        "path": "screenshots/live-dashboard.png"
      },
      {
        "name": "Query editor with roll and pitch streaming",
        "path": "screenshots/panel-editor.png"
      },
      {
        "name": "Configuration with the OpenRVDAS API",
        "path": "screenshots/config-editor.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.0.10 <12.1 || >=12.1.7 <12.2 || >=12.2.5",
    "plugins": []
  },
  "streaming": true,
  "alerting": false
}
